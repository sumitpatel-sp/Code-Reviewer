# Application settings
APP_NAME=AI Multi-Agent Code Review Platform
ENVIRONMENT=development
DEBUG=true

# MySQL settings used by Docker and the FastAPI application
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=code_review_db
MYSQL_USER=code_review_user
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# Authentication settings
# Generate a long random value before using this in a real environment.
SECRET_KEY=replace_with_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API key used by the AI review agents
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Local folder where uploaded ZIP files are saved
UPLOAD_DIRECTORY=app/uploads
MAX_UPLOAD_SIZE_MB=25
MAX_EXTRACTED_SIZE_MB=100
